# Ignore rules for this repository: it ships code and docs only, so whatever a
# match run writes locally (logs, archives, datasets) stays out of commits.
__pycache__/
*.pyc
.venv/
dist/
.zcode/
.video_agent/

# tool caches (pytest / ruff / mypy)
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Recorded match data is not published: this repository ships code and docs only.
# Ignoring these paths keeps a contributor's own match data out of commits.
# (dir/* + negation, because a re-include is impossible under an excluded dir.)
artifacts/*
!artifacts/README.md
dataset/*
!dataset/README.md
