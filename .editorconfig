root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown,yml,yaml,json,jsonl,toml}]
indent_size = 2
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[*.{sh,mjs,js}]
indent_size = 2

[Makefile]
indent_style = tab
